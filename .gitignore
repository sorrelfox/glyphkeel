# Rust build output
/target
**/*.rs.bk
rustc-ice-*.txt

# The UI's dependencies and build output
node_modules/
/ui/dist/
/ui/test-results/
/ui/playwright-report/
/ui/blob-report/
*.tsbuildinfo

# Schemas that tauri-build writes on every build
/crates/gk-app/gen/schemas/

# Local environment and editor files
.env
.env.*
.idea/
.vscode/
*.swp
.DS_Store

# Generated by the Tauri build on every run
crates/gk-app/permissions/autogenerated/

# The Flatpak's offline source lists, generated from the lock files when a
# release is built
/crates/gk-app/packaging/flatpak/cargo-sources.json
/crates/gk-app/packaging/flatpak/node-sources.json
