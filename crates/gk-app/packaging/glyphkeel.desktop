#
# The menu entry of the deb and rpm packages, filled in by the Tauri bundler.
[Desktop Entry]
Type=Application
Name={{name}}
GenericName=Task Manager
Comment=Plan and track tasks on boards and lists, kept on this computer
Exec={{exec}}
Icon={{icon}}
StartupWMClass={{exec}}
Terminal=false
Categories=Office;ProjectManagement;
Keywords=tasks;todo;kanban;board;project;planning;
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
