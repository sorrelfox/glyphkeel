{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glyphkeel",
  "mainBinaryName": "glyphkeel-app",
  "identifier": "io.github.sorrelfox.Glyphkeel",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:5310",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' gk-file: data: blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self' 'unsafe-inline' http://127.0.0.1:5310",
        "style-src": "'self' 'unsafe-inline' http://127.0.0.1:5310",
        "img-src": "'self' gk-file: data: blob: http://127.0.0.1:5310",
        "font-src": "'self' http://127.0.0.1:5310",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:5310 http://127.0.0.1:5310",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.png", "icons/icon.ico"],
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/glyphkeel.desktop",
        "section": "utils",
        "recommends": [
          "libayatana-appindicator3-1",
          "hunspell-en-us"
        ],
        "files": {
          "/usr/share/metainfo/io.github.sorrelfox.Glyphkeel.metainfo.xml": "packaging/io.github.sorrelfox.Glyphkeel.metainfo.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "packaging/glyphkeel.desktop",
        "recommends": [
          "libayatana-appindicator-gtk3",
          "hunspell-en-US"
        ],
        "files": {
          "/usr/share/metainfo/io.github.sorrelfox.Glyphkeel.metainfo.xml": "packaging/io.github.sorrelfox.Glyphkeel.metainfo.xml"
        }
      }
    },
    "category": "Productivity",
    "shortDescription": "Plan and track tasks on your own computer",
    "longDescription": "A local-only task manager with boards, lists, a wiki, a command line and a built-in MCP server. It keeps everything in a folder on your disk and never connects to the network.",
    "homepage": "https://sorrelfox.github.io/glyphkeel/",
    "publisher": "sorrelfox",
    "copyright": "Copyright (C) 2026 Glyphkeel contributors"
  }
}
