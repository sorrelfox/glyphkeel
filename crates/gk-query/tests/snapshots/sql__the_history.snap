---
source: crates/gk-query/tests/sql.rs
expression: "golden(&[\"was:status:Review\", \"was:category:closed -was:type:Bug\",\n\"was:label:bug,crash was:priority:high was:version:1.0\", \"changed:due>-7d\",\n\"changed:status:this-week,2026-11-01..2026-11-02\",\n\"changed:due,start -changed-by:agent\", \"changed-by:me,Helper\",], None,)"
---
-- was:status:Review
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND coalesce(((s.name_fold IN (?)) OR t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND (replace(json_extract(a.changes, '$.fields.status.before'), '-', '') IN (SELECT lower(hex(x.id)) FROM statuses x WHERE x.name_fold IN (?)) OR replace(json_extract(a.changes, '$.fields.status.after'), '-', '') IN (SELECT lower(hex(x.id)) FROM statuses x WHERE x.name_fold IN (?))))), 0) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "review", "review", "review", 50, 0

-- was:category:closed -was:type:Bug
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce(((s.category IN (?, ?)) OR t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND (replace(json_extract(a.changes, '$.fields.status.before'), '-', '') IN (SELECT lower(hex(x.id)) FROM statuses x WHERE x.category IN (?, ?)) OR replace(json_extract(a.changes, '$.fields.status.after'), '-', '') IN (SELECT lower(hex(x.id)) FROM statuses x WHERE x.category IN (?, ?))))), 0) AND NOT coalesce(((y.name_fold IN (?)) OR t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND (replace(json_extract(a.changes, '$.fields.type.before'), '-', '') IN (SELECT lower(hex(x.id)) FROM task_types x WHERE x.name_fold IN (?)) OR replace(json_extract(a.changes, '$.fields.type.after'), '-', '') IN (SELECT lower(hex(x.id)) FROM task_types x WHERE x.name_fold IN (?))))), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "done", "cancelled", "done", "cancelled", "done", "cancelled", "bug", "bug", "bug", 50, 0

-- was:label:bug,crash was:priority:high was:version:1.0
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce(((EXISTS (SELECT 1 FROM task_labels tl JOIN labels l ON l.id = tl.label_id WHERE tl.task_id = t.id AND l.name_fold IN (?, ?))) OR t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND (EXISTS (SELECT 1 FROM json_each(a.changes, '$.fields.labels.before') j WHERE replace(j.value, '-', '') IN (SELECT lower(hex(x.id)) FROM labels x WHERE x.name_fold IN (?, ?))) OR EXISTS (SELECT 1 FROM json_each(a.changes, '$.fields.labels.after') j WHERE replace(j.value, '-', '') IN (SELECT lower(hex(x.id)) FROM labels x WHERE x.name_fold IN (?, ?)))))), 0) AND coalesce(((t.priority IN (?)) OR t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND (json_extract(a.changes, '$.fields.priority.before') IN (?) OR json_extract(a.changes, '$.fields.priority.after') IN (?)))), 0) AND coalesce(((t.fix_version_id IN (SELECT v.id FROM versions v WHERE v.name_fold IN (?))) OR t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND (replace(json_extract(a.changes, '$.fields.fix_version.before'), '-', '') IN (SELECT lower(hex(x.id)) FROM versions x WHERE x.name_fold IN (?)) OR replace(json_extract(a.changes, '$.fields.fix_version.after'), '-', '') IN (SELECT lower(hex(x.id)) FROM versions x WHERE x.name_fold IN (?))))), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "bug", "crash", "bug", "crash", "bug", "crash", 3, "high", "high", "1.0", "1.0", "1.0", 50, 0

-- changed:due>-7d
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND coalesce((t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND json_type(a.changes, '$.fields.created') IS NULL AND (json_type(a.changes, '$.fields.due_date') IS NOT NULL) AND (a.at >= ?))), 0) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: 1794870000000, 50, 0

-- changed:status:this-week,2026-11-01..2026-11-02
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND coalesce((t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND json_type(a.changes, '$.fields.created') IS NULL AND (json_type(a.changes, '$.fields.status') IS NOT NULL) AND (a.at BETWEEN ? AND ? OR a.at BETWEEN ? AND ?))), 0) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: 1795388400000, 1795993199999, 1793487600000, 1793660399999, 50, 0

-- changed:due,start -changed-by:agent
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce((t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND json_type(a.changes, '$.fields.created') IS NULL AND (json_type(a.changes, '$.fields.due_date') IS NOT NULL OR json_type(a.changes, '$.fields.start_date') IS NOT NULL))), 0) AND NOT coalesce((t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND json_type(a.changes, '$.fields.created') IS NULL AND (a.actor_kind = 'agent'))), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: 50, 0

-- changed-by:me,Helper
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND coalesce((t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND json_type(a.changes, '$.fields.created') IS NULL AND (a.actor_kind = 'user' OR a.actor_name = ? COLLATE NOCASE))), 0) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "Helper", 50, 0
