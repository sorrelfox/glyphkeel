---
source: crates/gk-query/tests/sql.rs
expression: "golden(&[\"\", \"is:open due<+7d\", \"label:bug,crash -status:Done updated>-3d\",\n\"type:Feature priority>=High sort:due,-priority\", \"project:TM/* is:overdue\",\n\"(label:bug OR type:Bug) is:open -is:blocked\", \"estimate:1h..4h -has:start\",\n\"created:this-month author:agent\", \"parent:TM-12\", \"parent:none\",\n\"claimed:\\\"Build Bot\\\"\", \"TM-41\", \"title:\\\"login page\\\" title=Exact\",\n\"category:closed progress>=50% comments>0\", \"due:none,today remaining<1h\",\n\"blocks:any relates:TM-2 under:TM-1\",], None,)"
---
-- 
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: 50, 0

-- is:open due<+7d
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce(((s.category IN ('todo', 'in_progress'))), 0) AND coalesce((t.due_date <= ?), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "2026-11-29", 50, 0

-- label:bug,crash -status:Done updated>-3d
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce((EXISTS (SELECT 1 FROM task_labels tl JOIN labels l ON l.id = tl.label_id WHERE tl.task_id = t.id AND l.name_fold IN (?, ?))), 0) AND NOT coalesce((s.name_fold IN (?)), 0) AND coalesce((t.updated_at >= ?), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "bug", "crash", "done", 1795215600000, 50, 0

-- type:Feature priority>=High sort:due,-priority
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce((y.name_fold IN (?)), 0) AND coalesce((t.priority >= ?), 0)) ORDER BY t.due_date ASC NULLS LAST, t.priority DESC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "feature", 3, 50, 0

-- project:TM/* is:overdue
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND (p.state = 'active' OR t.project_id IN (SELECT * FROM (WITH RECURSIVE sub(id) AS (SELECT id FROM projects WHERE key = ? OR id IN (SELECT project_id FROM project_key_aliases WHERE key = ?) UNION SELECT c.id FROM projects c JOIN sub ON c.parent_id = sub.id) SELECT id FROM sub))) AND (coalesce((t.project_id IN (SELECT * FROM (WITH RECURSIVE sub(id) AS (SELECT id FROM projects WHERE key = ? OR id IN (SELECT project_id FROM project_key_aliases WHERE key = ?) UNION SELECT c.id FROM projects c JOIN sub ON c.parent_id = sub.id) SELECT id FROM sub))), 0) AND coalesce(((s.category IN ('todo', 'in_progress') AND t.due_date < ?)), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "TM", "TM", "TM", "TM", "2026-11-23", 50, 0

-- (label:bug OR type:Bug) is:open -is:blocked
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND ((coalesce((EXISTS (SELECT 1 FROM task_labels tl JOIN labels l ON l.id = tl.label_id WHERE tl.task_id = t.id AND l.name_fold IN (?))), 0) OR coalesce((y.name_fold IN (?)), 0)) AND coalesce(((s.category IN ('todo', 'in_progress'))), 0) AND NOT coalesce(((EXISTS (SELECT 1 FROM task_relations r JOIN tasks o ON o.id = r.from_task WHERE r.to_task = t.id AND r.kind = 'blocks' AND o.deleted_at IS NULL AND o.closed_at IS NULL))), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "bug", "bug", 50, 0

-- estimate:1h..4h -has:start
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce((t.estimate_min BETWEEN ? AND ?), 0) AND NOT coalesce((t.start_date IS NOT NULL), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: 60, 240, 50, 0

-- created:this-month author:agent
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce((t.created_at BETWEEN ? AND ?), 0) AND coalesce((t.created_by_kind = 'agent'), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: 1793487600000, 1796079599999, 50, 0

-- parent:TM-12
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND coalesce((t.parent_id IN (SELECT k.id FROM tasks k JOIN projects kp ON kp.id = k.project_id WHERE kp.key = ? AND k.number = ? UNION ALL SELECT a.task_id FROM task_key_aliases a WHERE a.project_key = ? AND a.number = ? UNION ALL SELECT k.id FROM tasks k JOIN project_key_aliases pa ON pa.project_id = k.project_id WHERE pa.key = ? AND k.number = ?)), 0) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "TM", 12, "TM", 12, "TM", 12, 50, 0

-- parent:none
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND coalesce((t.parent_id IS NULL), 0) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: 50, 0

-- claimed:"Build Bot"
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND coalesce((t.claim_session IS NOT NULL AND t.claim_until > ? AND t.claim_name COLLATE NOCASE IN (?)), 0) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: 1795431300000, "Build Bot", 50, 0

-- TM-41
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND coalesce((t.id IN (SELECT k.id FROM tasks k JOIN projects kp ON kp.id = k.project_id WHERE kp.key = ? AND k.number = ? UNION ALL SELECT a.task_id FROM task_key_aliases a WHERE a.project_key = ? AND a.number = ? UNION ALL SELECT k.id FROM tasks k JOIN project_key_aliases pa ON pa.project_id = k.project_id WHERE pa.key = ? AND k.number = ?)), 0) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "TM", 41, "TM", 41, "TM", 41, 50, 0

-- title:"login page" title=Exact
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce((t.title_fold LIKE ? ESCAPE '\' AND t.title_fold LIKE ? ESCAPE '\'), 0) AND coalesce((t.title_fold = ?), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "%login%", "%page%", "exact", 50, 0

-- category:closed progress>=50% comments>0
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce((s.category IN (?, ?)), 0) AND coalesce(((CASE WHEN t.progress_override IS NOT NULL THEN t.progress_override WHEN t.closed_at IS NOT NULL THEN 100 WHEN t.checklist_total > 0 THEN t.checklist_done * 100 / t.checklist_total ELSE coalesce((SELECT CAST(round(avg(CASE WHEN c.progress_override IS NOT NULL THEN c.progress_override WHEN c.closed_at IS NOT NULL THEN 100 WHEN c.checklist_total > 0 THEN c.checklist_done * 100.0 / c.checklist_total ELSE 0 END)) AS INTEGER) FROM tasks c WHERE c.parent_id = t.id AND c.deleted_at IS NULL), 0) END) >= ?), 0) AND coalesce(((SELECT count(*) FROM comments c WHERE c.task_id = t.id AND c.deleted_at IS NULL) >= ?), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "done", "cancelled", 50, 1, 50, 0

-- due:none,today remaining<1h
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce((t.due_date = ? OR t.due_date IS NULL), 0) AND coalesce(((t.estimate_min - t.spent_min) <= ?), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "2026-11-23", 59, 50, 0

-- blocks:any relates:TM-2 under:TM-1
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce((EXISTS (SELECT 1 FROM task_relations r JOIN tasks o ON o.id = r.to_task WHERE r.kind = 'blocks' AND r.from_task = t.id AND o.deleted_at IS NULL)), 0) AND coalesce((EXISTS (SELECT 1 FROM task_relations r JOIN tasks o ON o.id = r.to_task WHERE r.kind = 'relates' AND r.from_task = t.id AND o.deleted_at IS NULL AND r.to_task IN (SELECT k.id FROM tasks k JOIN projects kp ON kp.id = k.project_id WHERE kp.key = ? AND k.number = ? UNION ALL SELECT a.task_id FROM task_key_aliases a WHERE a.project_key = ? AND a.number = ? UNION ALL SELECT k.id FROM tasks k JOIN project_key_aliases pa ON pa.project_id = k.project_id WHERE pa.key = ? AND k.number = ?)) OR EXISTS (SELECT 1 FROM task_relations r JOIN tasks o ON o.id = r.from_task WHERE r.kind = 'relates' AND r.to_task = t.id AND o.deleted_at IS NULL AND r.from_task IN (SELECT k.id FROM tasks k JOIN projects kp ON kp.id = k.project_id WHERE kp.key = ? AND k.number = ? UNION ALL SELECT a.task_id FROM task_key_aliases a WHERE a.project_key = ? AND a.number = ? UNION ALL SELECT k.id FROM tasks k JOIN project_key_aliases pa ON pa.project_id = k.project_id WHERE pa.key = ? AND k.number = ?))), 0) AND coalesce((t.id IN (SELECT * FROM (WITH RECURSIVE below(id) AS (SELECT c.id FROM tasks c WHERE c.parent_id IN (SELECT k.id FROM tasks k JOIN projects kp ON kp.id = k.project_id WHERE kp.key = ? AND k.number = ? UNION ALL SELECT a.task_id FROM task_key_aliases a WHERE a.project_key = ? AND a.number = ? UNION ALL SELECT k.id FROM tasks k JOIN project_key_aliases pa ON pa.project_id = k.project_id WHERE pa.key = ? AND k.number = ?) UNION SELECT c.id FROM tasks c JOIN below ON c.parent_id = below.id) SELECT id FROM below))), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "TM", 2, "TM", 2, "TM", 2, "TM", 2, "TM", 2, "TM", 2, "TM", 1, "TM", 1, "TM", 1, 50, 0
