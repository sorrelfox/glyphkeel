---
source: crates/gk-query/tests/sql.rs
expression: "golden(&[\"was:cf.area:\\\"front END\\\" -was:cf.approved:yes\",\n\"was:cf.points:3 was:cf.ticket=ABC-1\", \"changed:status,cf.points\",\n\"changed:cf.review-on>-7d\",], None,)"
---
-- was:cf.area:"front END" -was:cf.approved:yes
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce(((EXISTS (SELECT 1 FROM custom_values v JOIN custom_fields f ON f.id = v.field_id WHERE v.task_id = t.id AND f.query_name = ? AND (lower(v.value) IN (lower(?))))) OR t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND EXISTS (SELECT 1 FROM json_each(a.changes, '$.fields') j WHERE replace(j.key, '-', '') IN (SELECT 'cf:' || lower(hex(f.id)) FROM custom_fields f WHERE f.query_name IN (?)) AND (EXISTS (SELECT 1 FROM json_each(j.value, '$.before') x WHERE lower(x.value) IN (lower(?))) OR EXISTS (SELECT 1 FROM json_each(j.value, '$.after') x WHERE lower(x.value) IN (lower(?))))))), 0) AND NOT coalesce(((EXISTS (SELECT 1 FROM custom_values v JOIN custom_fields f ON f.id = v.field_id WHERE v.task_id = t.id AND f.query_name = ? AND (v.value = 1))) OR t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND EXISTS (SELECT 1 FROM json_each(a.changes, '$.fields') j WHERE replace(j.key, '-', '') IN (SELECT 'cf:' || lower(hex(f.id)) FROM custom_fields f WHERE f.query_name IN (?)) AND (EXISTS (SELECT 1 FROM json_each(j.value, '$.before') x WHERE x.value = 1) OR EXISTS (SELECT 1 FROM json_each(j.value, '$.after') x WHERE x.value = 1))))), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "area", "Front end", "area", "Front end", "Front end", "approved", "approved", 50, 0

-- was:cf.points:3 was:cf.ticket=ABC-1
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND (coalesce(((EXISTS (SELECT 1 FROM custom_values v JOIN custom_fields f ON f.id = v.field_id WHERE v.task_id = t.id AND f.query_name = ? AND (v.value = ?))) OR t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND EXISTS (SELECT 1 FROM json_each(a.changes, '$.fields') j WHERE replace(j.key, '-', '') IN (SELECT 'cf:' || lower(hex(f.id)) FROM custom_fields f WHERE f.query_name IN (?)) AND (EXISTS (SELECT 1 FROM json_each(j.value, '$.before') x WHERE x.value = ?) OR EXISTS (SELECT 1 FROM json_each(j.value, '$.after') x WHERE x.value = ?))))), 0) AND coalesce(((EXISTS (SELECT 1 FROM custom_values v JOIN custom_fields f ON f.id = v.field_id WHERE v.task_id = t.id AND f.query_name = ? AND (lower(v.value) IN (lower(?))))) OR t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND EXISTS (SELECT 1 FROM json_each(a.changes, '$.fields') j WHERE replace(j.key, '-', '') IN (SELECT 'cf:' || lower(hex(f.id)) FROM custom_fields f WHERE f.query_name IN (?)) AND (EXISTS (SELECT 1 FROM json_each(j.value, '$.before') x WHERE lower(x.value) IN (lower(?))) OR EXISTS (SELECT 1 FROM json_each(j.value, '$.after') x WHERE lower(x.value) IN (lower(?))))))), 0)) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "points", 3, "points", 3, 3, "ticket", "ABC-1", "ticket", "ABC-1", "ABC-1", 50, 0

-- changed:status,cf.points
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND coalesce((t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND json_type(a.changes, '$.fields.created') IS NULL AND (json_type(a.changes, '$.fields.status') IS NOT NULL OR EXISTS (SELECT 1 FROM json_each(a.changes, '$.fields') j WHERE replace(j.key, '-', '') IN (SELECT 'cf:' || lower(hex(f.id)) FROM custom_fields f WHERE f.query_name IN (?)))))), 0) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "points", 50, 0

-- changed:cf.review-on>-7d
SELECT t.id FROM tasks t JOIN projects p ON p.id = t.project_id JOIN statuses s ON s.id = t.status_id JOIN task_types y ON y.id = t.type_id WHERE t.deleted_at IS NULL AND p.deleted_at IS NULL AND p.state = 'active' AND coalesce((t.id IN (SELECT a.entity_id FROM activity a WHERE a.entity_kind = 'task' AND json_type(a.changes, '$.fields.created') IS NULL AND (EXISTS (SELECT 1 FROM json_each(a.changes, '$.fields') j WHERE replace(j.key, '-', '') IN (SELECT 'cf:' || lower(hex(f.id)) FROM custom_fields f WHERE f.query_name IN (?)))) AND (a.at >= ?))), 0) ORDER BY s.rank ASC NULLS LAST, t.rank ASC NULLS LAST, p.key ASC, t.number ASC LIMIT ? OFFSET ?
-- params: "review-on", 1794870000000, 50, 0
